<Page x:Class="ClaudiumStudiosLauncher.Views.EventsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="34" Spacing="22"><TextBlock Text="EVENTS" FontSize="38" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Border CornerRadius="20" Background="{StaticResource NeonGradient}"/><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{Binding Title}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedText}"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding StartDate}"/><TextBlock Text="→" Foreground="{StaticResource MutedText}"/><TextBlock Text="{Binding EndDate}"/></StackPanel></StackPanel><Border Grid.Column="2" CornerRadius="18" Padding="16" Background="#3322D3EE" VerticalAlignment="Center"><StackPanel HorizontalAlignment="Center"><Ellipse Width="12" Height="12" Fill="{StaticResource SuccessBrush}"/><TextBlock Text="{Binding Status}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</Page>
