<Page x:Class="ClaudiumStudiosLauncher.Views.StorePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="34" Spacing="22"><TextBlock Text="STORE" FontSize="38" FontWeight="Bold"/><TextBlock Text="Games, DLC, expansions, cosmetics, currency, and premium content." Foreground="{StaticResource MutedText}"/><ItemsControl ItemsSource="{Binding Games}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="350" Height="330" CornerRadius="26" Padding="22" Background="{StaticResource CardBrush}" BorderBrush="#2AFFFFFF" BorderThickness="1" Margin="0,0,18,18"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Bottom" Spacing="8"><Border Height="120" CornerRadius="20" Background="{StaticResource NeonGradient}"/><TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" MaxHeight="50"/><TextBlock Text="Included with Claudium Account" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold"/></StackPanel><Button Grid.Row="1" Style="{StaticResource PremiumButtonStyle}" HorizontalAlignment="Stretch" Content="VIEW OFFER" Margin="0,16,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</Page>
