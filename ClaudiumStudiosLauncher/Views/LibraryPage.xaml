<Page x:Class="ClaudiumStudiosLauncher.Views.LibraryPage" x:Name="LibraryRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="34" Spacing="22"><TextBlock Text="LIBRARY" FontSize="38" FontWeight="Bold"/><TextBlock Text="{Binding OfflineBanner}" Foreground="{StaticResource WarningBrush}"/><ItemsControl ItemsSource="{Binding Games}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><Border CornerRadius="20" Background="{StaticResource NeonGradient}"/><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Installed / Not Installed"/><TextBlock Text="•" Foreground="{StaticResource MutedText}"/><TextBlock Text="{Binding Version}" Foreground="{StaticResource MutedText}"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Button Style="{StaticResource PremiumButtonStyle}" Content="INSTALL" Command="{Binding DataContext.InstallCommand, ElementName=LibraryRoot}" CommandParameter="{Binding}"/><Button Style="{StaticResource GlassButtonStyle}" Content="PLAY" Command="{Binding DataContext.PlayCommand, ElementName=LibraryRoot}" CommandParameter="{Binding}"/><Button Style="{StaticResource GlassButtonStyle}" Content="REPAIR" Command="{Binding DataContext.RepairCommand, ElementName=LibraryRoot}" CommandParameter="{Binding}"/><Button Style="{StaticResource DangerButtonStyle}" Content="UNINSTALL" Command="{Binding DataContext.UninstallCommand, ElementName=LibraryRoot}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</Page>
