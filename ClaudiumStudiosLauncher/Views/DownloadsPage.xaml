<Page x:Class="ClaudiumStudiosLauncher.Views.DownloadsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="34" Spacing="22"><TextBlock Text="DOWNLOADS" FontSize="38" FontWeight="Bold"/><Border Style="{StaticResource GlassCardStyle}"><StackPanel Spacing="16"><TextBlock Text="ACTIVE TRANSFERS" Foreground="{StaticResource MutedText}"/><ItemsControl ItemsSource="{Binding Downloads}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#66101A2F" CornerRadius="22" Padding="22" Margin="0,0,0,14"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Border CornerRadius="18" Background="{StaticResource NeonGradient}"/><StackPanel Grid.Column="1" Spacing="9"><TextBlock Text="{Binding GameId}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentFile}" Foreground="{StaticResource MutedText}"/><ProgressBar Value="{Binding Progress}" Maximum="100" Height="10" Foreground="{StaticResource AccentCyanBrush}" Background="#33000000"/><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="{Binding Progress}"/><TextBlock Text="%"/><TextBlock Text="{Binding BytesPerSecond}"/><TextBlock Text="B/s"/><TextBlock Text="ETA" Foreground="{StaticResource MutedText}"/><TextBlock Text="{Binding Eta}"/></StackPanel></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10"><TextBlock Text="{Binding Status}" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Style="{StaticResource GlassButtonStyle}" Content="PAUSE"/><Button Style="{StaticResource DangerButtonStyle}" Content="CANCEL"/></StackPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border CornerRadius="22" Padding="30" BorderBrush="#2233FFFFFF" BorderThickness="1" Background="#2217D4EE"><StackPanel HorizontalAlignment="Center" Spacing="8"><TextBlock Text="NO ACTIVE DOWNLOADS" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Install or update Claudium Studios games to see progress here." Foreground="{StaticResource MutedText}"/></StackPanel></Border></StackPanel></Border></StackPanel></ScrollViewer>
</Page>
