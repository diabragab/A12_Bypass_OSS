<Page x:Class="ClaudiumStudiosLauncher.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="34" Spacing="22"><TextBlock Text="SETTINGS" FontSize="38" FontWeight="Bold"/><Grid ColumnSpacing="18" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassCardStyle}"><StackPanel Spacing="16"><TextBlock Text="GENERAL" FontSize="20" FontWeight="SemiBold"/><ToggleSwitch Header="Auto update games" IsOn="{Binding LauncherSettings.AutoUpdate, Mode=TwoWay}"/><ToggleSwitch Header="Launch on Windows startup" IsOn="{Binding LauncherSettings.LaunchOnWindowsStartup, Mode=TwoWay}"/><ToggleSwitch Header="Minimize after game starts" IsOn="{Binding LauncherSettings.MinimizeAfterGameStarts, Mode=TwoWay}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource GlassCardStyle}"><StackPanel Spacing="16"><TextBlock Text="DOWNLOADS" FontSize="20" FontWeight="SemiBold"/><TextBox Header="Download location" Text="{Binding LauncherSettings.DownloadLocation, Mode=TwoWay}"/><StackPanel Spacing="6"><TextBlock Text="Maximum download speed" Foreground="{StaticResource MutedText}"/><Slider Minimum="0" Maximum="100" Value="50"/></StackPanel><ComboBox Header="Language" SelectedValue="{Binding LauncherSettings.Language, Mode=TwoWay}"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Arabic" Tag="ar"/></ComboBox></StackPanel></Border><Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource GlassCardStyle}"><StackPanel Spacing="16"><TextBlock Text="APPEARANCE" FontSize="20" FontWeight="SemiBold"/><ComboBox Header="Theme" SelectedValue="{Binding LauncherSettings.Theme, Mode=TwoWay}"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="System"/></ComboBox><Button Style="{StaticResource PremiumButtonStyle}" Content="SAVE SETTINGS" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/></StackPanel></Border></Grid></StackPanel></ScrollViewer>
</Page>
