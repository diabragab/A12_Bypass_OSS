<Page x:Class="ClaudiumStudiosLauncher.Views.HomePage" x:Name="HomeRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsTabStop="True">
  <Page.Resources>
    <Storyboard x:Name="SlideIntroStoryboard"><DoubleAnimation Storyboard.TargetName="SlideContent" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.48"/><DoubleAnimation Storyboard.TargetName="SlideContentTranslate" Storyboard.TargetProperty="X" From="-34" To="0" Duration="0:0:0.48"/><DoubleAnimation Storyboard.TargetName="SlideArtworkScale" Storyboard.TargetProperty="ScaleX" From="1.04" To="1" Duration="0:0:0.65"/><DoubleAnimation Storyboard.TargetName="SlideArtworkScale" Storyboard.TargetProperty="ScaleY" From="1.04" To="1" Duration="0:0:0.65"/><DoubleAnimation Storyboard.TargetName="LightSweep" Storyboard.TargetProperty="Opacity" From="0.06" To="0.22" Duration="0:0:0.7"/></Storyboard>
    <Storyboard x:Name="SlideOutStoryboard"><DoubleAnimation Storyboard.TargetName="SlideContent" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.22"/><DoubleAnimation Storyboard.TargetName="SlideContentTranslate" Storyboard.TargetProperty="X" From="0" To="24" Duration="0:0:0.22"/></Storyboard>
  </Page.Resources>
  <ScrollViewer><StackPanel Padding="34" Spacing="28"><TextBlock Text="{Binding OfflineBanner}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
    <Border x:Name="GameSlider" MinHeight="520" CornerRadius="34" BorderBrush="#3AFFFFFF" BorderThickness="1" PointerEntered="OnSliderPointerEntered" PointerExited="OnSliderPointerExited"><Grid><Border RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="SlideArtworkScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform><Grid><Image Source="{Binding SelectedGame.Banner}" Stretch="UniformToFill" Opacity="0.62"/><Rectangle Fill="{StaticResource HeroOverlayGradient}"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F2050812" Offset="0"/><GradientStop Color="#D9050812" Offset="0.42"/><GradientStop Color="#66050812" Offset="0.75"/><GradientStop Color="#22050812" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Rectangle VerticalAlignment="Bottom" Height="220"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00050812" Offset="0"/><GradientStop Color="#EE050812" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Rectangle x:Name="LightSweep" Width="420" Opacity="0.12" HorizontalAlignment="Right" Fill="{StaticResource NeonGradient}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="18"/></Rectangle.RenderTransform></Rectangle></Grid></Border>
      <Grid Padding="44"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><StackPanel x:Name="SlideContent" VerticalAlignment="Bottom" Spacing="16" Opacity="1"><StackPanel.RenderTransform><TranslateTransform x:Name="SlideContentTranslate" X="0"/></StackPanel.RenderTransform><TextBlock Text="CLAUDIUM STUDIOS" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" CharacterSpacing="180"/><TextBlock Text="{Binding SelectedGame.Name}" FontSize="60" FontWeight="Bold" TextWrapping="WrapWholeWords"/><TextBlock Text="{Binding SelectedGame.Description}" FontSize="18" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="780"/><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#3322D3EE" CornerRadius="12" Padding="12,6"><TextBlock Text="{Binding SelectedGame.Genre}" FontWeight="SemiBold"/></Border><Border Background="#2234D399" CornerRadius="12" Padding="12,6"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}"/><TextBlock Text="ONLINE" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#337C3AED" CornerRadius="12" Padding="12,6"><TextBlock Text="AVAILABLE" FontWeight="SemiBold"/></Border></StackPanel><StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12,0,0"><Button Style="{StaticResource PlayButtonStyle}" Content="{Binding SelectedGameActionLabel}" Command="{Binding PrimaryActionCommand}" CommandParameter="{Binding SelectedGame}"/><Button Style="{StaticResource GlassButtonStyle}" Content="VIEW GAME" Click="OnViewGame"/></StackPanel></StackPanel>
        <StackPanel x:Name="SliderControls" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Spacing="18" Opacity="0.86"><TextBlock Text="{Binding SlideCounter}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Style="{StaticResource GlassButtonStyle}" Content="‹" FontSize="28" Click="OnPreviousSlide"/><Button Style="{StaticResource GlassButtonStyle}" Content="›" FontSize="28" Click="OnNextSlide"/></StackPanel><ItemsControl ItemsSource="{Binding Games}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="OnIndicatorClicked" Background="Transparent" BorderThickness="0" Padding="4"><Border Width="34" Height="6" CornerRadius="3" Background="{StaticResource NeonGradient}" Opacity="0.8"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      </Grid>
      <Border x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#6610182A" BorderBrush="#3322D3EE" BorderThickness="1" CornerRadius="28" Padding="34"><StackPanel Spacing="10"><TextBlock Text="CLAUDIUM STUDIOS" FontSize="18" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/><TextBlock Text="NO GAMES AVAILABLE" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="The launcher will display games automatically when the backend returns them." Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Border>
    </Grid></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Featured Games" FontSize="28" FontWeight="SemiBold"/><Button Grid.Column="1" Style="{StaticResource GlassButtonStyle}" Content="BROWSE ALL"/></Grid>
    <ItemsControl ItemsSource="{Binding Games}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="330" Height="235" Background="{StaticResource CardBrush}" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="24" Padding="20" Margin="0,0,18,18"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Bottom" Spacing="8"><TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Genre}" Foreground="{StaticResource MutedText}"/><Border Width="86" Height="6" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource NeonGradient}"/></StackPanel><Button Grid.Row="1" HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource PremiumButtonStyle}" Content="INSTALL / PLAY" Command="{Binding DataContext.InstallCommand, ElementName=HomeRoot}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</Page>
