<Page x:Class="ClaudiumStudiosLauncher.Views.NewsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="34" Spacing="22"><TextBlock Text="NEWS" FontSize="38" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding News}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="360" Height="260" CornerRadius="24" Padding="22" Margin="0,0,18,18" BorderBrush="#2AFFFFFF" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4417D4EE" Offset="0"/><GradientStop Color="#AA11182A" Offset="0.6"/><GradientStop Color="#557C3AED" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel VerticalAlignment="Bottom" Spacing="9"><TextBlock Text="ANNOUNCEMENT" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" MaxHeight="58"/><TextBlock Text="{Binding Date}" Foreground="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</Page>
