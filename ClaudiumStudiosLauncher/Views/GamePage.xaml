<Page x:Class="ClaudiumStudiosLauncher.Views.GamePage" x:Name="GameRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="34" Spacing="24"><Border MinHeight="390" CornerRadius="30" Padding="34" Background="{StaticResource HeroOverlayGradient}" BorderBrush="#3AFFFFFF" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Bottom" Spacing="12"><TextBlock Text="GAME DETAILS" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGame.Name}" FontSize="54" FontWeight="Bold"/><TextBlock Text="{Binding SelectedGame.Description}" Foreground="{StaticResource MutedText}" FontSize="18" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding SelectedGame.Genre}"/><TextBlock Text="•"/><TextBlock Text="{Binding SelectedGame.Version}"/></StackPanel></StackPanel><Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" VerticalAlignment="Bottom"><StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="10"><Ellipse Width="12" Height="12" Fill="{StaticResource SuccessBrush}"/><TextBlock Text="ONLINE" FontWeight="Bold"/></StackPanel><TextBlock Text="1,248 Players" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="62ms Ping" Foreground="{StaticResource MutedText}"/><Button Style="{StaticResource PlayButtonStyle}" Content="▶  PLAY" Command="{Binding PlayCommand}" CommandParameter="{Binding SelectedGame}"/></StackPanel></Border></Grid></Border><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassCardStyle}"><StackPanel Spacing="12"><TextBlock Text="SCREENSHOTS" FontWeight="SemiBold"/><Grid RowSpacing="10" ColumnSpacing="10"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Height="120" CornerRadius="18" Background="{StaticResource NeonGradient}"/><Border Grid.Column="1" Height="120" CornerRadius="18" Background="#554B1D95"/><Border Grid.Row="1" Height="120" CornerRadius="18" Background="#5522D3EE"/><Border Grid.Row="1" Grid.Column="1" Height="120" CornerRadius="18" Background="#3310182A"/></Grid></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource GlassCardStyle}"><StackPanel Spacing="12"><TextBlock Text="INSTALLATION" FontWeight="SemiBold"/><Button Style="{StaticResource PremiumButtonStyle}" Content="INSTALL / UPDATE" Command="{Binding InstallCommand}" CommandParameter="{Binding SelectedGame}"/><Button Style="{StaticResource GlassButtonStyle}" Content="REPAIR" Command="{Binding RepairCommand}" CommandParameter="{Binding SelectedGame}"/><Button Style="{StaticResource DangerButtonStyle}" Content="UNINSTALL" Command="{Binding UninstallCommand}" CommandParameter="{Binding SelectedGame}"/></StackPanel></Border></Grid></StackPanel></ScrollViewer>
</Page>
