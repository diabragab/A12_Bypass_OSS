<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="ColorBase">#050812</Color><Color x:Key="ColorPanel">#CC11182A</Color><Color x:Key="ColorGlass">#99111A2F</Color><Color x:Key="ColorCard">#DD151E34</Color><Color x:Key="ColorText">#F5F8FF</Color><Color x:Key="ColorMuted">#A7B3D6</Color><Color x:Key="ColorCyan">#22D3EE</Color><Color x:Key="ColorViolet">#8B5CF6</Color><Color x:Key="ColorDanger">#FB3B62</Color><Color x:Key="ColorSuccess">#34D399</Color><Color x:Key="ColorWarning">#F59E0B</Color>
  <SolidColorBrush x:Key="AppBackground" Color="{StaticResource ColorBase}"/><SolidColorBrush x:Key="PanelBrush" Color="{StaticResource ColorPanel}"/><SolidColorBrush x:Key="GlassBrush" Color="{StaticResource ColorGlass}"/><SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorCard}"/><SolidColorBrush x:Key="PrimaryText" Color="{StaticResource ColorText}"/><SolidColorBrush x:Key="MutedText" Color="{StaticResource ColorMuted}"/><SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource ColorCyan}"/><SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource ColorViolet}"/><SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}"/><SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/><SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}"/>
  <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#22D3EE" Offset="0"/><GradientStop Color="#7C3AED" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroOverlayGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EE050812" Offset="0"/><GradientStop Color="#AA101B36" Offset="0.55"/><GradientStop Color="#5514D6EC" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#AA17213A" Offset="0"/><GradientStop Color="#66101A2F" Offset="1"/></LinearGradientBrush>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/><Setter Property="FontFamily" Value="Segoe UI Variable Display"/></Style>
  <Style x:Key="ChromeButtonStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource MutedText}"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="CornerRadius" Value="9"/></Style>
  <Style x:Key="PremiumButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource NeonGradient}"/><Setter Property="BorderBrush" Value="#66FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter><Setter Property="Transitions"><Setter.Value><TransitionCollection><RepositionThemeTransition/></TransitionCollection></Setter.Value></Setter></Style>
  <Style x:Key="PlayButtonStyle" BasedOn="{StaticResource PremiumButtonStyle}" TargetType="Button"><Setter Property="MinWidth" Value="152"/><Setter Property="MinHeight" Value="52"/><Setter Property="FontSize" Value="16"/></Style>
  <Style x:Key="GlassButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/><Setter Property="Background" Value="#2217D4EE"/><Setter Property="BorderBrush" Value="#5522D3EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20,11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource GlassButtonStyle}" TargetType="Button"><Setter Property="BorderBrush" Value="#88FB3B62"/><Setter Property="Foreground" Value="#FFFFD7DF"/></Style>
  <Style x:Key="SidebarButtonStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource MutedText}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="14,12"/><Setter Property="MinHeight" Value="52"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/></Style>
  <Style x:Key="GlassCardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelGradient}"/><Setter Property="BorderBrush" Value="#2AFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Padding" Value="24"/></Style>
</ResourceDictionary>
