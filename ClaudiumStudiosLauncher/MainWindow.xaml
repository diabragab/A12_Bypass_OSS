<Window x:Class="ClaudiumStudiosLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CLAUDIUM STUDIOS Launcher">
  <Grid Background="{StaticResource AppBackground}">
    <Grid.Resources>
      <Storyboard x:Name="AmbientStoryboard" RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="GlowOrb" Storyboard.TargetProperty="Opacity" From="0.38" To="0.72" Duration="0:0:7"/><DoubleAnimation Storyboard.TargetName="BeamOne" Storyboard.TargetProperty="Opacity" From="0.08" To="0.22" Duration="0:0:9"/><DoubleAnimation Storyboard.TargetName="ParticleField" Storyboard.TargetProperty="Opacity" From="0.18" To="0.42" Duration="0:0:6"/></Storyboard>
    </Grid.Resources>
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#050812" Offset="0"/><GradientStop Color="#071227" Offset="0.55"/><GradientStop Color="#02030A" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Ellipse x:Name="GlowOrb" Width="920" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-300,0" Opacity="0.45" Fill="{StaticResource NeonGradient}"/>
    <Rectangle x:Name="BeamOne" Height="220" Width="1600" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,250,0,0" Opacity="0.12" RenderTransformOrigin="0.5,0.5" Fill="{StaticResource NeonGradient}"><Rectangle.RenderTransform><RotateTransform Angle="-14"/></Rectangle.RenderTransform></Rectangle>
    <Canvas x:Name="ParticleField" Opacity="0.28"><Ellipse Width="3" Height="3" Fill="#77FFFFFF" Canvas.Left="260" Canvas.Top="170"/><Ellipse Width="2" Height="2" Fill="#9922D3EE" Canvas.Left="920" Canvas.Top="120"/><Ellipse Width="4" Height="4" Fill="#667C3AED" Canvas.Left="1380" Canvas.Top="340"/><Ellipse Width="2" Height="2" Fill="#77FFFFFF" Canvas.Left="1180" Canvas.Top="760"/><Ellipse Width="3" Height="3" Fill="#7722D3EE" Canvas.Left="430" Canvas.Top="840"/></Canvas>
    <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#00000000" Offset="0.35"/><GradientStop Color="#AA00030A" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Grid RowSpacing="0">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/></Grid.RowDefinitions>
      <Grid x:Name="TitleBarDragRegion" Background="#6610182A" Padding="22,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="154"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="12"><Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource NeonGradient}"><TextBlock Text="CS" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="CLAUDIUM STUDIOS" FontSize="18" FontWeight="SemiBold" CharacterSpacing="120"/><TextBlock Text="OFFICIAL GAME LAUNCHER" Foreground="{StaticResource MutedText}" FontSize="10" CharacterSpacing="160"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4"><Button Style="{StaticResource ChromeButtonStyle}" Content="—" Click="OnMinimize"/><Button Style="{StaticResource ChromeButtonStyle}" Content="□" Click="OnMaximizeRestore"/><Button Style="{StaticResource ChromeButtonStyle}" Content="✕" Click="OnClose"/></StackPanel></Grid>
      <Grid Grid.Row="1" Margin="24,20,24,24"><Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,22,0"><StackPanel Spacing="14"><TextBlock Text="CLAUDIUM" FontSize="26" FontWeight="Bold"/><TextBlock Text="STUDIOS" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/><Rectangle Height="1" Fill="#2AFFFFFF" Margin="0,8"/><Button Style="{StaticResource SidebarButtonStyle}" Tag="Home" Click="OnSidebarNavigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;"/><TextBlock Text="HOME" FontWeight="SemiBold"/></StackPanel></Button><Button Style="{StaticResource SidebarButtonStyle}" Tag="Library" Click="OnSidebarNavigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8F1;"/><TextBlock Text="LIBRARY" FontWeight="SemiBold"/></StackPanel></Button><Button Style="{StaticResource SidebarButtonStyle}" Tag="Store" Click="OnSidebarNavigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE719;"/><TextBlock Text="STORE" FontWeight="SemiBold"/></StackPanel></Button><Button Style="{StaticResource SidebarButtonStyle}" Tag="News" Click="OnSidebarNavigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8A5;"/><TextBlock Text="NEWS" FontWeight="SemiBold"/></StackPanel></Button><Button Style="{StaticResource SidebarButtonStyle}" Tag="Events" Click="OnSidebarNavigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE787;"/><TextBlock Text="EVENTS" FontWeight="SemiBold"/></StackPanel></Button><Button Style="{StaticResource SidebarButtonStyle}" Tag="Downloads" Click="OnSidebarNavigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE896;"/><TextBlock Text="DOWNLOADS" FontWeight="SemiBold"/></StackPanel></Button><Grid Height="18"/><Border CornerRadius="18" Padding="16" Background="#3317D4EE" BorderBrush="#3322D3EE" BorderThickness="1"><StackPanel Spacing="8"><TextBlock Text="SERVER SIGNAL" Foreground="{StaticResource MutedText}" FontSize="11"/><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}"/><TextBlock Text="ONLINE" FontWeight="SemiBold"/></StackPanel></StackPanel></Border></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="0"><Grid><Frame x:Name="RootFrame" Opacity="1"/></Grid></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
